{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/informacoes/:slug",
      "destination": "/informacoes/:slug/index.html"
    },
    {
      "source": "/parceiros/:slug",
      "destination": "/parceiros/:slug/index.html"
    },
    {
      "source": "/politica-privacidade",
      "destination": "/politica-privacidade/index.html"
    },
    {
      "source": "/termos-uso",
      "destination": "/termos-uso/index.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies/index.html"
    }
  ]
}
